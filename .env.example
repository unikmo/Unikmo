# UNIKMO: Less stuff. More us.
# New commerce runs through Stripe; Shopify settings below are legacy only.

# Stripe Checkout — one-time payment Price IDs (all must be configured and approved)
# Keep STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET server-side only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_FOUR=
STRIPE_PRICE_SEVEN=
STRIPE_PRICE_CURATED_KEEP_PHYSICAL=
STRIPE_PRICE_CURATED_KEEP_DIGITAL=
STRIPE_PRICE_CURATED_SHOW_PHYSICAL=
STRIPE_PRICE_CURATED_SHOW_DIGITAL=
STRIPE_PRICE_EXTRA_CARD=
STRIPE_SHIPPING_RATE_ID=
# ISO two-letter codes for verified destinations only, comma-separated.
STRIPE_SHIPPING_COUNTRIES=
NEXT_PUBLIC_SITE_URL=https://www.unikmo.com
CURATED_ORDER_EMAIL=
# Activate these only after Stripe test-mode order, duplicate webhook and email QA.
STRIPE_FULFILLMENT_ENABLED=false
# Hard stop for live charges unless explicitly approved after checkout QA.
STRIPE_LIVE_CHECKOUT_ENABLED=false
# Only true if Stripe Tax is configured for your account and obligations.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Never accept new Shopify orders. Historical processing only after explicit review.
SHOPIFY_HISTORICAL_WEBHOOKS_ENABLED=false

# MongoDB
# Your MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/madonna

# Amazon S3 (browser uploads use presigned PUT URLs)
# Replace placeholders with your AWS account values. Configure bucket CORS to allow PUT from your site origin.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME_EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=your-bucket-name
# Public URL prefix for saved media links (optional). If unset, URLs use virtual-hosted style:
# https://{AWS_S3_BUCKET}.s3.{AWS_REGION}.amazonaws.com/...
# AWS_S3_PUBLIC_BASE_URL=https://d111111abcdef8.cloudfront.net
# Presigned PUT expiry in seconds (default 14400 = 4h). Min 600, max 604800. Use a higher value for slow connections.
# AWS_S3_PRESIGN_EXPIRES_SECONDS=14400

# LEGACY Shopify — historical read-only support only
# Your Shopify store domain (e.g., your-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Admin API access token from Shopify
SHOPIFY_ACCESS_TOKEN=your_access_token
# Webhook secret for HMAC validation
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret
# LEGACY Shopify — historical read-only support only API version (use latest, e.g., 2024-10)
SHOPIFY_API_VERSION=2024-10
# Optional: force price currency (e.g. USD) if shop.currencyCode differs (e.g. Shopify base vs presentment)
# CURRENCY_OVERRIDE=USD

# Application
# Your application base URL (e.g., https://yourdomain.com or http://localhost:3000 for dev)
BASE_URL=http://localhost:3000
# Secret key for JWT token signing (use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# SMTP (Nodemailer)
# Email service configuration for sending Moment Codes
#
# cPanel / shared hosting: use "Outgoing server" from Manual settings (often mail.yourdomain.com), port 465, SSL.
# Example: SMTP_HOST=mail.planethike.org  SMTP_PORT=465
# GoDaddy-only generic host (smtpout.secureserver.net) may NOT match if your mailbox is on cPanel for that domain.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Sender email address (usually same as SMTP_USER for cPanel)
SMTP_FROM=noreply@yourdomain.com
# EMAIL_PROVIDER=smtp  # force SMTP only (see lib/email.ts)
# Contact form submissions are sent to this email (default: mbanwie@gmail.com if unset)
CONTACT_EMAIL=mbanwie@gmail.com

# Admin Seed
# Initial admin user credentials (used by npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here







